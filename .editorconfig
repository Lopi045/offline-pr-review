# Tells any editor how to format files, so contributors' editors agree
# (indent size, charset, line endings). See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
